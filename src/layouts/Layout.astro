---
import '../styles/global.css'; 

// Recibimos el idioma en el Layout (por defecto inglés)
const { title = "Hatim Debboun · Backend Developer", lang = "en" } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Java Backend Developer specialized in Spring Boot, event-driven architectures and REST APIs." />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased">
    <slot />
  </body>
</html>