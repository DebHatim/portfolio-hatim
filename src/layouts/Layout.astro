---
// ¡El import va AQUÍ DENTRO, entre los guiones!
import '../styles/global.css'; 

const { title = "Hatim Debboun · Backend Developer" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Java Backend Developer specialized in Spring Boot, event-driven architectures and REST APIs." />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased">
    <slot />
  </body>
</html>