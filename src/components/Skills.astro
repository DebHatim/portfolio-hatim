---
import { languages } from '../data/ui.js';

const { lang = "en" } = Astro.props;
const t = languages[lang];

const groups = [
  { label: "Backend", items: ["Java 21", "Spring Boot", "Spring Security", "REST APIs", "Apache Kafka", "WebSocket"] },
  { label: "Persistence", items: ["JPA/Hibernate", "MySQL", "PostgreSQL"] },
  { label: t['stack.testing.text'], items: ["JUnit 5", "Mockito", "Clean Code", "SOLID"] }, // ¡Llaves corregidas aquí!
  { label: "DevOps", items: ["Docker", "GitHub Actions", "CI/CD", "Nginx"] },
  { label: "Frontend", items: ["React", "JavaScript ES6+", "Tailwind CSS"] },
];
---
<section class="max-w-4xl mx-auto px-6 py-16 border-t border-slate-800">
  <h3 class="text-sm uppercase tracking-widest text-emerald-400 mb-8">Stack</h3>
  <div class="grid sm:grid-cols-2 gap-8">
    {groups.map((g) => (
      <div>
        <p class="text-slate-400 text-sm font-medium mb-3">{g.label}</p>
        <div class="flex flex-wrap gap-2">
          {g.items.map((i) => (
            <span class="text-xs bg-slate-800 text-slate-200 px-3 py-1.5 rounded-full">{i}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>