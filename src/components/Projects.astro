---
import { languages } from '../data/ui.js';
import ProjectCard from "./ProjectCard.astro";
import { projectsConfig } from "../data/projects.js";

const { lang = "en" } = Astro.props;
const t = languages[lang];
---
<section id="projects" class="mx-auto max-w-7xl border-t border-prussian px-6 py-16">
  <p data-reveal class="mb-8 font-mono text-sm tracking-wide text-spring uppercase">
    > {t['nav.projects']}
  </p>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projectsConfig.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
  </div>
</section>