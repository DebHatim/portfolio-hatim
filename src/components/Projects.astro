---
import ProjectCard from "./ProjectCard.astro";
import { projectsConfig } from "../data/projects.js";

const { lang = "en" } = Astro.props;
---
<section class="max-w-4xl mx-auto px-6 py-16 border-t border-slate-800">
  <h3 class="text-sm uppercase tracking-widest text-emerald-400 mb-8">
    {lang === "es" ? "Proyectos" : "Projects"}
  </h3>
  <div class="grid gap-6">
    {projectsConfig.map((p) => <ProjectCard project={p} lang={lang} />)}
  </div>
</section>