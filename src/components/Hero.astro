---
import { languages } from '../data/ui.js';
import ArrowUpRight from './icons/ArrowUpRight.astro';

const { lang = "en" } = Astro.props;
const t = languages[lang];
---
<section id="hero" class="mx-auto max-w-6xl px-6 pt-24 pb-20">
  <div data-reveal class="flex flex-col md:flex-row items-center justify-between gap-12">
    <div class="flex-1">
      <p class="mb-6 font-mono text-xs tracking-wide text-spring">{t['hero.title']}</p>

      <h1 class="font-display text-5xl font-semibold tracking-tight text-spring md:text-6xl drop-shadow-sm">
        Hatim Debboun
      </h1>
      <h2 class="mt-3 text-xl text-alabaster md:text-2xl">{t['hero.subtitle']}</h2>

      <p class="mt-6 max-w-2xl leading-relaxed text-lavender">{t['hero.description']}</p>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="#contact"
           class="inline-flex items-center gap-2 border border-spring bg-spring/10 px-5 py-2.5 font-mono text-sm text-spring transition-all hover:bg-spring hover:text-ink">
          {t['hero.contactbutton.text']}
          <ArrowUpRight size={12} />
        </a>

        <a href="https://github.com/DebHatim" target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 text-sm font-mono text-lavender transition-colors hover:text-spring">
          GitHub
          <ArrowUpRight size={10} />
        </a>

        <a href="https://linkedin.com/in/hatimdebboun" target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 text-sm font-mono text-lavender transition-colors hover:text-spring">
          LinkedIn
          <ArrowUpRight size={10} />
        </a>

        <a href="/HatimDebboun_CV_EN.pdf" target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 text-sm font-mono text-lavender transition-colors hover:text-spring">
          {t['hero.resume1.text']}
          <ArrowUpRight size={10} />
        </a>

        <a href="/HatimDebboun_CV.pdf" target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 text-sm font-mono text-lavender transition-colors hover:text-spring">
          {t['hero.resume2.text']}
          <ArrowUpRight size={10} />
        </a>
      </div>
    </div>
    <div class="w-40 md:w-52 shrink-0">
      <img src="/spring-boot-logo.webp" alt="Spring Boot" width="160" height="160" class="spring-logo w-full h-auto drop-shadow-xl"/>
    </div>
  </div>
</section>