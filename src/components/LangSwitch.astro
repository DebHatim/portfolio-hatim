---
const { current } = Astro.props; // "en" o "es"
---
<div class="fixed top-6 right-6 flex gap-1 bg-slate-900/80 backdrop-blur border border-slate-800 rounded-full p-1 text-xs font-medium z-50">
  <a href="/" class={`px-3 py-1.5 rounded-full transition-colors ${current === "en" ? "bg-emerald-600 text-white" : "text-slate-400 hover:text-white"}`}>EN</a>
  <a href="/es" class={`px-3 py-1.5 rounded-full transition-colors ${current === "es" ? "bg-emerald-600 text-white" : "text-slate-400 hover:text-white"}`}>ES</a>
</div>