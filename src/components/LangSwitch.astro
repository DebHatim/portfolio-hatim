---
const { lang = "en" } = Astro.props;
---
<div class="fixed bottom-6 left-6 z-40 flex items-center overflow-hidden border border-spring/30 bg-ink/90 shadow-lg backdrop-blur font-mono text-xs">
  <a href="/" class={`px-3 py-2 transition-colors ${lang === "en" ? "bg-spring text-ink font-semibold" : "text-lavender hover:bg-spring/10 hover:text-spring"}`}>EN</a>
  <a href="/es" class={`px-3 py-2 transition-colors border-l border-spring/30 ${lang === "es" ? "bg-spring text-ink font-semibold" : "text-lavender hover:bg-spring/10 hover:text-spring"}`}>ES</a>
</div>