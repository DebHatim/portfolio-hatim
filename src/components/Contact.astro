---
import { languages } from '../data/ui.js';

const { lang = "en" } = Astro.props;
const t = languages[lang];
---
<section id="contact" class="mx-auto max-w-6xl border-t border-prussian px-6 py-16">
  <div data-reveal>
    <p class="mb-6 font-mono text-sm tracking-wide text-spring uppercase">> {t['nav.contact']}</p>
    <h3 class="font-display text-2xl font-semibold text-alabaster">{t['contact.title']}</h3>
    <p class="mt-2 text-lavender">{t['contact.subtitle']}</p>

    <a href="mailto:thos.debboun.hatim@gmail.com"
       class="mt-6 inline-flex items-center border border-spring bg-spring/10 px-5 py-2.5 font-mono text-sm text-spring transition-all hover:bg-spring hover:text-ink">
      thos.debboun.hatim@gmail.com
    </a>

    <div class="mt-20 flex flex-col md:flex-row items-center justify-between gap-4 border-t border-dusk/30 pt-8">
      <p class="font-mono text-xs text-lavender">{t['footer.copy']}</p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/DebHatim" target="_blank" rel="noopener" class="font-mono text-xs text-lavender hover:text-spring transition-colors">GitHub</a>
        <a href="https://linkedin.com/in/hatimdebboun" target="_blank" rel="noopener" class="font-mono text-xs text-lavender hover:text-spring transition-colors">LinkedIn</a>
      </div>
    </div>
  </div>
</section>