---
import { languages } from '../data/ui.js';

const { lang = "en" } = Astro.props;
const t = languages[lang];
---
<section class="max-w-4xl mx-auto px-6 py-16 border-t border-slate-800 text-center">
  <h3 class="text-2xl font-semibold mb-3">{t['contact.title']}</h3>
  <p class="text-slate-400 mb-6">{t['contact.subtitle']}</p>
  <a href="mailto:thos.debboun.hatim@gmail.com"
     class="inline-block px-6 py-3 bg-emerald-600 hover:bg-emerald-500 rounded-lg font-medium transition-colors">
    thos.debboun.hatim@gmail.com
  </a>
  <p class="text-slate-600 text-xs mt-12">{t['contact.copy']}</p>
</section>