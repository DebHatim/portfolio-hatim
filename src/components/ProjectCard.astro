---
import { languages } from "../data/ui.js";
import ArrowUpRight from "./icons/ArrowUpRight.astro";

const { project, lang = "en", index = 0 } = Astro.props;
const t = languages[lang];

const title = t[`projects.${project.id}.title`];
const description = t[`projects.${project.id}.description`];

const status = t[`projects.${project.id}.status`];
---

<article data-reveal style={`transition-delay: ${index * 90}ms`} class="group flex flex-col border border-dusk/40 bg-prussian transition-colors hover:border-spring/50">
  
  <div class="relative aspect-4/3 w-full overflow-hidden border-b border-dusk/40 bg-white/5 p-4 flex items-center justify-center">
    <img src={project.image} alt={`${title} preview`} loading="lazy" 
      class="h-full w-full object-contain drop-shadow-lg transition-transform duration-500 group-hover:scale-105"/>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h4 class="font-display text-lg font-semibold text-alabaster group-hover:text-spring transition-colors">
      {title}
    </h4>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-lavender">
      {description}
    </p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {
        project.stack.map((s) => (
          <span class="border border-dusk/40 bg-ink/50 px-2 py-0.5 font-mono text-[11px] text-lavender">
            {s}
          </span>
        ))
      }
    </div>
    <hr class="mt-5 border-t border-dusk/30" />

    <div class="mt-4 flex items-center justify-center">
      <span class="border border-spring/30 bg-spring/10 px-2 py-0.5 font-mono text-[11px] text-spring">
        {status}
      </span>
    </div>

    <div class="mt-5 flex flex-col gap-3 border-t border-dusk/30 pt-4">
      <a href={project.github} target="_blank" rel="noopener"
        class="flex w-full items-center justify-center gap-2 border border-dusk/50 bg-ink/50 py-2.5 px-4 text-sm font-medium text-alabaster transition-colors hover:border-spring hover:bg-spring/10 hover:text-spring"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
          ></path>
        </svg>
        {t["projects.repobutton.text"]}
      </a>

      {
        project.live && (
          <a href={project.live} target="_blank" rel="noopener"
            class="flex w-full items-center justify-center gap-1.5 text-sm text-lavender transition-colors hover:text-spring">
            {t["projects.demobutton.text"]}
            <ArrowUpRight size={11} />
          </a>
        )
      }
    </div>
  </div>
</article>
