---
import { languages } from '../data/ui.js';

const { project, lang = "en" } = Astro.props;
const t = languages[lang];

const title = t[`projects.${project.id}.title`];
const description = t[`projects.${project.id}.description`];
---
<div class="border border-slate-800 rounded-xl p-6 hover:border-emerald-500/50 transition-colors">
  <h4 class="text-xl font-semibold mb-2">{title}</h4>
  <p class="text-slate-400 text-sm leading-relaxed mb-4">{description}</p>

  <ul class="mb-4 space-y-1.5">
    {project.points.map((pointKey) => (
      <li class="text-sm text-slate-300 flex gap-2">
        <span class="text-emerald-400">▸</span>
        {t[`projects.${project.id}.${pointKey}`]}
      </li>
    ))}
  </ul>

  <div class="flex flex-wrap gap-2 mb-5">
    {project.stack.map((s) => (
      <span class="text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded-md">{s}</span>
    ))}
  </div>

  <div class="flex gap-3">
    <a href={project.github} target="_blank" rel="noopener"
       class="text-sm text-emerald-400 hover:text-emerald-300 font-medium">
      GitHub →
    </a>
    {project.live && (
      <a href={project.live} target="_blank" rel="noopener"
         class="text-sm text-emerald-400 hover:text-emerald-300 font-medium">
        {t['projects.demobutton.text']} →
      </a>
    )}
  </div>
</div>