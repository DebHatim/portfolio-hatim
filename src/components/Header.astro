---
import { languages } from '../data/ui.js';

const { lang = "en" } = Astro.props;
const t = languages[lang];
---
<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-ink/80 border-b border-prussian/50 transition-colors duration-300">
  <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
    
    <div class="flex-1 hidden md:block"></div>

    <nav class="hidden md:flex items-center justify-center gap-8 font-mono text-sm flex-shrink-0">
      <a href="#" class="text-lavender hover:text-spring transition-colors">{t['nav.home']}</a>
      <a href="#projects" class="text-lavender hover:text-spring transition-colors">{t['nav.projects']}</a>
      <a href="#skills" class="text-lavender hover:text-spring transition-colors">{t['nav.skills']}</a>
      
      <a href="#contact" class="text-spring border border-spring px-5 py-1.5 hover:bg-spring hover:text-ink transition-all">
        {t['nav.contact']}
      </a>
    </nav>
    
    <div class="flex-1 flex justify-end">
      <button id="themeToggle" aria-label="Toggle Theme" class="text-lavender hover:text-spring transition-colors p-2">
        <svg class="icon-sun w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
    
  </div>
</header>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("light");
    
    const isLight = element.classList.contains("light");
    localStorage.setItem("theme", isLight ? "light" : "dark");
  };

  document.getElementById("themeToggle")?.addEventListener("click", handleToggleClick);
</script>